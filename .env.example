DATABASE_URL=postgresql://user:password@host:5432/crimax_sports
SECRET_KEY=replace-with-a-256-bit-random-hex-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALLOWED_ORIGINS=https://sports.crimax.ng,http://localhost:3000
# Apply pending sql/ migrations on startup; set false to run them as a deploy step
AUTO_MIGRATE=true
FRONTEND_URL=https://sports.crimax.ng
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email — Zoho Mail REST API (OAuth2 self-client refresh token).
# Leave EMAILS_ENABLED=false in dev: emails are logged instead of sent.
EMAILS_ENABLED=false
EMAIL_FROM_NAME=Crimax Sports
# Create a Self Client at https://api-console.zoho.com with scopes:
#   ZohoMail.messages.CREATE,ZohoMail.accounts.READ
# then exchange for a refresh token.
# Or keep only messages.CREATE and pin ZOHO_ACCOUNT_ID (recommended).
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# The Zoho mailbox mail is sent from (e.g. no-reply@yourdomain.com)
ZOHO_FROM_ADDRESS=
# Strongly recommended — skips GET /api/accounts (avoids accounts.READ scope).
# ZOHO_ACCOUNT_ID=
# Match your Zoho data center (.com, .eu, .in, .com.au, .jp)
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_MAIL_API_URL=https://mail.zoho.com
INVITE_EXPIRE_HOURS=72
PASSWORD_RESET_TTL_MINUTES=30
