DATABASE_URL=postgresql://user:password@host:5432/crimax_sports
SECRET_KEY=replace-with-a-256-bit-random-hex-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALLOWED_ORIGINS=https://sports.crimax.ng,http://localhost:3000
FRONTEND_URL=https://sports.crimax.ng
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Zoho Mail SMTP — use smtppro.zoho.com for custom-domain org accounts
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=you@yourdomain.com
SMTP_PASSWORD=zoho-app-specific-password
SMTP_FROM=you@yourdomain.com
SMTP_USE_SSL=true
INVITE_EXPIRE_HOURS=72
